# Copy to deploy.env (gitignored) and fill in. Every value can also be passed
# as an environment variable to ./deploy.sh or ./destroy.sh.

# Required ---------------------------------------------------------------
# Project hosting Cloud Run; also runs (and pays for) the BigQuery query jobs.
PROJECT_ID=my-gcp-project
# Dataset containing the ADK BigQuery Agent Analytics tables.
DATASET=bqca_agent_logging
# Comma-separated IAM members allowed through IAP.
IAP_MEMBERS=group:bqca-admins@example.com

# Optional ---------------------------------------------------------------
# Project that owns DATASET, if different from PROJECT_ID.
# DATA_PROJECT_ID=my-logging-project
# REGION=us-central1
# SERVICE=bqca-audit-ui
# SA_NAME=bqca-audit-ui
# Review-flag thresholds.
# SLOW_MS=15000
# HIGH_TOKENS=100000
# Per-query cost guard (bytes). Default 20 GiB.
# MAX_BYTES_BILLED=21474836480
# Only tables carrying this label are treated as agent-analytics tables ("" = all tables).
# TABLE_LABEL=adk_schema_version
